# WSL Web App + VirtualBox VM MySQL Configuration
APP_HOST=0.0.0.0
APP_PORT=8080

# VirtualBox VM MySQL Connection
# When using VirtualBox NAT port forwarding, WSL connects via the Windows host gateway IP
# or directly to the VirtualBox Host-Only IP (e.g. 192.168.56.101)
DB_HOST=192.168.56.1
DB_PORT=3306
DB_USER=monitor_user
DB_PASSWORD=monitor_pass
DB_NAME=os_monitor
